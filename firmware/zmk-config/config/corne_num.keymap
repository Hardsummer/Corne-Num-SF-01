/*
 * Corne Num v6 keymap: 62 keys (left 31, right 31).
 *   Num  (hold left thumb):  F1-F11 on the number row, F12 under F11, numpad on the right hand, brackets on the left
 *   Nav  (hold right thumb): Del on Bksp, arrows on W A S D and H J K L, Home/End/PgUp/PgDn, media on Z-B
 *   Adjust (hold Num + Nav): Bluetooth profiles, clear pairings, bootloader / reset on either half, U = ZMK Studio unlock
 *
 * Base extras: Ctrl+F10 and Win+L in the far-left column.
 *
 * Rows below follow the physical layout: each line is left half then right half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE   0
#define NUM    1
#define NAV    2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM NAV>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
   &kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp BSPC
   &kp LC(F10)   &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T         &kp LALT      &kp MINUS     &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSLH      &kp DEL
   &kp LG(L)     &kp CAPS      &kp A         &kp S         &kp D         &kp F         &kp G         &kp LGUI      &kp EQUAL     &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT       &kp RET
   &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B         &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RSHFT
   &kp LCTRL     &mo NUM       &kp SPACE     &kp SPACE     &mo NAV       &kp RCTRL
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
   &trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
   &studio_unlock &trans       &trans        &trans        &kp LBKT      &kp RBKT      &trans        &trans        &trans        &trans        &kp N7        &kp N8        &kp N9        &trans        &kp F12       &trans
   &trans        &trans        &trans        &trans        &kp LBRC      &kp RBRC      &trans        &trans        &trans        &trans        &kp N4        &kp N5        &kp N6        &trans        &trans        &trans
   &trans        &trans        &trans        &kp LPAR      &kp RPAR      &trans        &trans        &kp N1        &kp N2        &kp N3        &kp DOT       &trans
   &trans        &trans        &trans        &kp N0        &trans        &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
   &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &kp DEL
   &trans        &trans        &trans        &kp UP        &trans        &trans        &trans        &trans        &trans        &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp INS       &trans        &trans
   &trans        &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &trans        &trans        &trans        &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &kp PSCRN     &trans        &trans
   &trans        &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP      &kp C_NEXT    &trans        &trans        &trans        &trans        &trans        &trans
   &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
   &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none         &none         &none         &none         &none         &none
   &none         &bootloader   &sys_reset    &none         &none         &none         &none         &none         &none         &none         &studio_unlock &none         &none         &none         &sys_reset    &bootloader
   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
   &none         &trans        &none         &none         &trans        &none
            >;
        };
    };
};
