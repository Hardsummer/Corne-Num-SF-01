#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    /* 5 rows x 8 columns per half; the right half's columns are offset by 8.
       Pins (same on the rev 2 and rev 3 PCBs, both halves):
       rows R0..R4 = P0.22 P0.24 P1.00 P0.11 P1.04
       cols C0..C7 = P0.20 P0.31 P0.29 P0.02 P1.15 P1.13 P1.11 P1.06  (diodes COL2ROW) */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <5>;
        map = <
RC(0,1)   RC(0,2)   RC(0,3)   RC(0,4)   RC(0,5)   RC(0,6)   RC(0,14)  RC(0,13)  RC(0,12)  RC(0,11)  RC(0,10)  RC(0,9)
RC(1,0)   RC(1,1)   RC(1,2)   RC(1,3)   RC(1,4)   RC(1,5)   RC(1,6)   RC(1,7)   RC(1,15)  RC(1,14)  RC(1,13)  RC(1,12)  RC(1,11)  RC(1,10)  RC(1,9)   RC(1,8)
RC(2,0)   RC(2,1)   RC(2,2)   RC(2,3)   RC(2,4)   RC(2,5)   RC(2,6)   RC(2,7)   RC(2,15)  RC(2,14)  RC(2,13)  RC(2,12)  RC(2,11)  RC(2,10)  RC(2,9)   RC(2,8)
RC(3,1)   RC(3,2)   RC(3,3)   RC(3,4)   RC(3,5)   RC(3,6)   RC(3,14)  RC(3,13)  RC(3,12)  RC(3,11)  RC(3,10)  RC(3,9)
RC(4,5)   RC(4,6)   RC(4,7)   RC(4,15)  RC(4,14)  RC(4,13)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio1 6  GPIO_ACTIVE_HIGH>
            ;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Corne Num";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  //                     w   h     x     y    rot    rx    ry
            = <&key_physical_attrs 100 100   100    37      0     0     0>
            , <&key_physical_attrs 100 100   200    37      0     0     0>
            , <&key_physical_attrs 100 100   300    12      0     0     0>
            , <&key_physical_attrs 100 100   400     0      0     0     0>
            , <&key_physical_attrs 100 100   500    12      0     0     0>
            , <&key_physical_attrs 100 100   600    24      0     0     0>
            , <&key_physical_attrs 100 100  1000    24      0     0     0>
            , <&key_physical_attrs 100 100  1100    12      0     0     0>
            , <&key_physical_attrs 100 100  1200     0      0     0     0>
            , <&key_physical_attrs 100 100  1300    12      0     0     0>
            , <&key_physical_attrs 100 100  1400    37      0     0     0>
            , <&key_physical_attrs 100 100  1500    37      0     0     0>
            , <&key_physical_attrs 100 100     0   137      0     0     0>
            , <&key_physical_attrs 100 100   100   137      0     0     0>
            , <&key_physical_attrs 100 100   200   137      0     0     0>
            , <&key_physical_attrs 100 100   300   112      0     0     0>
            , <&key_physical_attrs 100 100   400   100      0     0     0>
            , <&key_physical_attrs 100 100   500   112      0     0     0>
            , <&key_physical_attrs 100 100   600   124      0     0     0>
            , <&key_physical_attrs 100 100   700   150      0     0     0>
            , <&key_physical_attrs 100 100   900   150      0     0     0>
            , <&key_physical_attrs 100 100  1000   124      0     0     0>
            , <&key_physical_attrs 100 100  1100   112      0     0     0>
            , <&key_physical_attrs 100 100  1200   100      0     0     0>
            , <&key_physical_attrs 100 100  1300   112      0     0     0>
            , <&key_physical_attrs 100 100  1400   137      0     0     0>
            , <&key_physical_attrs 100 100  1500   137      0     0     0>
            , <&key_physical_attrs 100 100  1600   137      0     0     0>
            , <&key_physical_attrs 100 100     0   237      0     0     0>
            , <&key_physical_attrs 100 100   100   237      0     0     0>
            , <&key_physical_attrs 100 100   200   237      0     0     0>
            , <&key_physical_attrs 100 100   300   212      0     0     0>
            , <&key_physical_attrs 100 100   400   200      0     0     0>
            , <&key_physical_attrs 100 100   500   212      0     0     0>
            , <&key_physical_attrs 100 100   600   224      0     0     0>
            , <&key_physical_attrs 100 100   700   250      0     0     0>
            , <&key_physical_attrs 100 100   900   250      0     0     0>
            , <&key_physical_attrs 100 100  1000   224      0     0     0>
            , <&key_physical_attrs 100 100  1100   212      0     0     0>
            , <&key_physical_attrs 100 100  1200   200      0     0     0>
            , <&key_physical_attrs 100 100  1300   212      0     0     0>
            , <&key_physical_attrs 100 100  1400   237      0     0     0>
            , <&key_physical_attrs 100 100  1500   237      0     0     0>
            , <&key_physical_attrs 100 100  1600   237      0     0     0>
            , <&key_physical_attrs 100 100   100   337      0     0     0>
            , <&key_physical_attrs 100 100   200   337      0     0     0>
            , <&key_physical_attrs 100 100   300   312      0     0     0>
            , <&key_physical_attrs 100 100   400   300      0     0     0>
            , <&key_physical_attrs 100 100   500   312      0     0     0>
            , <&key_physical_attrs 100 100   600   324      0     0     0>
            , <&key_physical_attrs 100 100  1000   324      0     0     0>
            , <&key_physical_attrs 100 100  1100   312      0     0     0>
            , <&key_physical_attrs 100 100  1200   300      0     0     0>
            , <&key_physical_attrs 100 100  1300   312      0     0     0>
            , <&key_physical_attrs 100 100  1400   337      0     0     0>
            , <&key_physical_attrs 100 100  1500   337      0     0     0>
            , <&key_physical_attrs 100 100   450   412      0     0     0>
            , <&key_physical_attrs 100 100   559   423   1200   609   473>
            , <&key_physical_attrs 100 100   674   435   2400   724   485>
            , <&key_physical_attrs 100 100   926   435  (-2400)   976   485>
            , <&key_physical_attrs 100 100  1041   423  (-1200)  1091   473>
            , <&key_physical_attrs 100 100  1150   412      0     0     0>
            ;
    };
};
